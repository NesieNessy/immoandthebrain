{
  "name": "immoandthebrain-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ImmoAndTheBrain - Real Estate Management Platform Monorepo",
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "type-check": "npm run type-check --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "test:watch": "npm run test:watch --workspace=apps/web",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "supabase:start": "cd supabase && supabase start",
    "supabase:stop": "cd supabase && supabase stop",
    "supabase:status": "cd supabase && supabase status"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "real-estate",
    "property-management",
    "monorepo",
    "nextjs",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint-config-next": "^16.2.9"
  }
}
